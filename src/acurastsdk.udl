namespace acurastsdk {
  AcurastRpc acurast_rpc();
};
[Custom]
typedef string BigUint;

dictionary Header {
  string parent_hash;
  string state_root;
  string extrinsics_root;
  BigUint number;
};

dictionary RuntimeVersion {
  i32 spec_version;
  i32 transaction_version;
};

enum Platform {
  "Android", "Ios",
};

dictionary ProcessorVersion {
  Platform platform;
  u32 build_number;
};

dictionary ProcessorUpdateInfo {
  bytes binary_location;
  ProcessorVersion version;
};

[Trait]
interface AcurastStorage {};

[Trait]
interface AcurastRpc {
  [Async]
  string? get_block_hash(i64? block_number, u64? timeout);
  [Async]
  Header? get_header(bytes? block_hash, u64? timeout);
  [Async]
  u32 get_api_version(bytes? block_hash, u64? timeout);
  [Async]
  RuntimeVersion get_runtime_version(bytes? block_hash, u64? timeout);
  [Async]
  ProcessorUpdateInfo? get_update_info(bytes account_id, bytes? block_hash, u64? timeout);
  [Async]
  bytes? get_known_binary_hash(ProcessorVersion version, bytes? block_hash, u64? timeout);
  [Async]
  string? submit_extrinsic(bytes extrinsic, u64? timeout);
  [Async]
  string? call(string method, bytes? data, bytes? block_hash, u64? timeout);
  AcurastStorage storage(u32 version);
};


